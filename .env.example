# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# Retrieval Neo4j (read-only MCP source)
RETRIEVAL_NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
RETRIEVAL_NEO4J_DATABASE=companies2
RETRIEVAL_NEO4J_USERNAME=companies2
RETRIEVAL_NEO4J_PASSWORD=companies2

# Local Neo4j MCP server is spawned by the backend over stdio — no URL needed.

# Memory Neo4j (local docker)
MEMORY_NEO4J_URI=bolt://localhost:7687
MEMORY_NEO4J_USERNAME=neo4j
MEMORY_NEO4J_PASSWORD=password
MEMORY_NEO4J_DATABASE=neo4j

# Backend
BACKEND_URL=http://localhost:8000
